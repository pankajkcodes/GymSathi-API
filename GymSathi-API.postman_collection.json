    {
      "name": "Reports & Stats",
      "item": [
        { "name": "Summary", "request": { "method": "GET", "url": { "raw": "{{base_url}}/reports/summary.php?gym_id={{gym_id}}",
          "host": ["{{base_url}}"], "path": ["reports", "summary.php"], "query": [{ "key": "gym_id", "value": "{{gym_id}}" }] } } },
