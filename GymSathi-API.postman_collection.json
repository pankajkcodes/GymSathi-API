{
  "info": {
    "name": "GymSathi API (v1)",
    "description": "Endpoints for the GymSathi backend (see GymSathi API/README.md). Auth: Bearer JWT for {{user_token}}/{{member_token}}, admin can use Bearer {{admin_token}} or the admin_token cookie. Reads are GET (query params), writes are POST (JSON body, or multipart when a file field is present).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{user_token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "https://api.gymsathi.in/v1", "description": "Live. Local: http://127.0.0.1:8099/v1 (php -S 127.0.0.1:8099 -t public)" },
    { "key": "user_token", "value": "" },
    { "key": "member_token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "cron_secret", "value": "" },
    { "key": "gym_id", "value": "" },
    { "key": "member_id", "value": "" },
    { "key": "batch_id", "value": "" },
    { "key": "plan_id", "value": "" },
    { "key": "expense_id", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "notification_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth (owner/staff)",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST", "auth": { "type": "noauth" },
            "url": "{{base_url}}/auth/login.php",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
              "raw": "{\n  \"email\": \"owner@example.com\",\n  \"password\": \"secret123\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) {",
            "  const d = pm.response.json();",
            "  if (d.data && d.data.token) pm.collectionVariables.set('user_token', d.data.token);",
            "}"
          ]}}]
        },
        {
          "name": "Login with Google",
          "request": {
            "method": "POST", "auth": { "type": "noauth" },
            "url": "{{base_url}}/auth/login-google.php",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
              "raw": "{\n  \"id_token\": \"<google-id-token>\"\n}" }
          }
        },
        {
          "name": "Forgot Password (send OTP)",
          "request": { "method": "POST", "auth": { "type": "noauth" }, "url": "{{base_url}}/auth/forgot-password.php",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"email\": \"owner@example.com\"\n}" } }
        },
        {
          "name": "Reset Password",
          "request": { "method": "POST", "auth": { "type": "noauth" }, "url": "{{base_url}}/auth/reset-password.php",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
              "raw": "{\n  \"email\": \"owner@example.com\",\n  \"otp\": \"123456\",\n  \"new_password\": \"newSecret123\"\n}" } }
        },
        {
          "name": "Me",
          "request": { "method": "GET", "url": "{{base_url}}/auth/me.php" }
        },
        {
          "name": "Update Profile",
          "request": { "method": "POST", "url": "{{base_url}}/auth/update-profile.php",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
              "raw": "{\n  \"name\": \"Owner Name\",\n  \"phone\": \"9999999999\",\n  \"email\": \"owner@example.com\"\n}" } }
        },
        {
          "name": "Change Password",
          "request": { "method": "POST", "url": "{{base_url}}/auth/change-password.php",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
              "raw": "{\n  \"current_password\": \"oldSecret123\",\n  \"new_password\": \"newSecret123\"\n}" } }
        }
      ]
    },
    {
      "name": "Signup (public)",
      "item": [
        {
          "name": "Register (free/manual)",
          "request": { "method": "POST", "auth": { "type": "noauth" }, "url": "{{base_url}}/signup/register.php",
            "description": "multipart/form-data when uploading a logo file field: logo",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
              "raw": "{\n  \"gym_name\": \"Iron Gym\",\n  \"owner_name\": \"Owner Name\",\n  \"email\": \"owner@example.com\",\n  \"password\": \"secret123\",\n  \"phone\": \"9999999999\",\n  \"address\": \"123 Main St\",\n  \"id_token\": \"\"\n}" } }
        },
        {
          "name": "Send Email OTP",
          "request": { "method": "POST", "auth": { "type": "noauth" }, "url": "{{base_url}}/signup/send-email-otp.php",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"email\": \"owner@example.com\"\n}" } }
        },
        {
          "name": "Verify Email OTP",
          "request": { "method": "POST", "auth": { "type": "noauth" }, "url": "{{base_url}}/signup/verify-email-otp.php",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
              "raw": "{\n  \"email\": \"owner@example.com\",\n  \"otp\": \"123456\"\n}" } }
        },
        {
          "name": "Paid Signup - Create Order",
          "request": { "method": "POST", "auth": { "type": "noauth" }, "url": "{{base_url}}/signup/paid-order.php",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
              "raw": "{\n  \"plan_id\": 1,\n  \"email\": \"owner@example.com\",\n  \"owner_name\": \"Owner Name\"\n}" } }
        },
        {
          "name": "Paid Signup - Verify Payment",
          "request": { "method": "POST", "auth": { "type": "noauth" }, "url": "{{base_url}}/signup/paid-verify.php",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
              "raw": "{\n  \"razorpay_order_id\": \"\",\n  \"razorpay_payment_id\": \"\",\n  \"razorpay_signature\": \"\",\n  \"owner_name\": \"Owner Name\",\n  \"email\": \"owner@example.com\",\n  \"password\": \"secret123\",\n  \"phone\": \"9999999999\",\n  \"gym_name\": \"Iron Gym\",\n  \"address\": \"\",\n  \"district\": \"\",\n  \"state\": \"\",\n  \"pincode\": \"\"\n}" } }
        }
      ]
    },
    {
      "name": "Gyms",
      "item": [
        {
          "name": "List My Gyms",
          "request": { "method": "GET", "url": "{{base_url}}/gyms/list.php" }
        },
        {
          "name": "Show Gym",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/gyms/show.php?gym_id={{gym_id}}",
            "host": ["{{base_url}}"], "path": ["gyms", "show.php"], "query": [{ "key": "gym_id", "value": "{{gym_id}}" }] } }
        },
        {
          "name": "Create Gym",
          "request": { "method": "POST", "url": "{{base_url}}/gyms/create.php",
            "description": "multipart/form-data when uploading logo file field: logo",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
              "raw": "{\n  \"gym_name\": \"Iron Gym\",\n  \"phone\": \"9999999999\",\n  \"address\": \"123 Main St\"\n}" } }
        },
        {
          "name": "Update Gym",
          "request": { "method": "POST", "url": "{{base_url}}/gyms/update.php",
            "description": "multipart/form-data when uploading logo file field: logo",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
              "raw": "{\n  \"gym_id\": \"{{gym_id}}\",\n  \"gym_name\": \"Iron Gym Updated\",\n  \"phone\": \"9999999999\",\n  \"address\": \"123 Main St\"\n}" } }
        },
        {
          "name": "Delete Gym",
          "request": { "method": "POST", "url": "{{base_url}}/gyms/delete.php",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}}, "raw": "{\n  \"gym_id\": \"{{gym_id}}\"\n}" } }
        }
      ]
    },
    {
      "name": "Staff",
      "item": [
        {
          "name": "List Staff",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/staff/list.php?gym_id={{gym_id}}",
            "host": ["{{base_url}}"], "path": ["staff", "list.php"], "query": [{ "key": "gym_id", "value": "{{gym_id}}" }] } }
        },
        {
          "name": "Create Staff",
          "request": { "method": "POST", "url": "{{base_url}}/staff/create.php",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
              "raw": "{\n  \"gym_ids\": [\"{{gym_id}}\"],\n  \"email\": \"staff@example.com\",\n  \"name\": \"Staff Name\",\n  \"phone\": \"9999999999\",\n  \"password\": \"secret123\",\n  \"role\": \"manager\",\n  \"permissions\": {\"members\": {\"read\": true, \"write\": true}}\n}" } }
        },
        {
          "name": "Update Staff",
          "request": { "method": "POST", "url": "{{base_url}}/staff/update.php",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
              "raw": "{\n  \"gym_id\": \"{{gym_id}}\",\n  \"user_id\": \"{{user_id}}\",\n  \"role\": \"manager\",\n  \"permissions\": {\"members\": {\"read\": true, \"write\": false}}\n}" } }
        },
        {
          "name": "Delete Staff",
          "request": { "method": "POST", "url": "{{base_url}}/staff/delete.php",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
              "raw": "{\n  \"gym_id\": \"{{gym_id}}\",\n  \"user_id\": \"{{user_id}}\"\n}" } }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "List Members",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/members/list.php?gym_id={{gym_id}}&filter=all&search=&page=1&limit=20",
            "host": ["{{base_url}}"], "path": ["members", "list.php"],
            "query": [
              { "key": "gym_id", "value": "{{gym_id}}" },
              { "key": "filter", "value": "all", "description": "all | active | expired | unpaid | new_members ..." },
              { "key": "search", "value": "" },
              { "key": "page", "value": "1" },
              { "key": "limit", "value": "20" }
            ] } }
        },
        {
          "name": "Show Member",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/members/show.php?gym_id={{gym_id}}&member_id={{member_id}}",
            "host": ["{{base_url}}"], "path": ["members", "show.php"],
            "query": [{ "key": "gym_id", "value": "{{gym_id}}" }, { "key": "member_id", "value": "{{member_id}}" }] } }
        },
        {
          "name": "Create Member",
          "request": { "method": "POST", "url": "{{base_url}}/members/create.php",
            "description": "multipart/form-data when uploading photo field: profile_image",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
              "raw": "{\n  \"gym_id\": \"{{gym_id}}\",\n  \"name\": \"Member Name\",\n  \"phone\": \"9999999999\",\n  \"email\": \"member@example.com\",\n  \"start_date\": \"2026-01-01\",\n  \"expiry_date\": \"2026-12-31\",\n  \"batch_id\": \"{{batch_id}}\",\n  \"plan_id\": \"{{plan_id}}\",\n  \"status\": \"active\"\n}" } }
        },
        {
          "name": "Update Member",
          "request": { "method": "POST", "url": "{{base_url}}/members/update.php",
            "description": "multipart/form-data when uploading photo field: profile_image. Only fields sent are updated (name, phone, email, start_date, expiry_date, batch_id, plan_id, status).",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
              "raw": "{\n  \"gym_id\": \"{{gym_id}}\",\n  \"member_id\": \"{{member_id}}\",\n  \"name\": \"Member Name Updated\"\n}" } }
        },
        {
          "name": "Set Member Status",
          "request": { "method": "POST", "url": "{{base_url}}/members/set-status.php",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
              "raw": "{\n  \"gym_id\": \"{{gym_id}}\",\n  \"member_id\": \"{{member_id}}\",\n  \"status\": \"active\"\n}" } }
        },
        {
          "name": "Delete Member",
          "request": { "method": "POST", "url": "{{base_url}}/members/delete.php",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
              "raw": "{\n  \"gym_id\": \"{{gym_id}}\",\n  \"member_id\": \"{{member_id}}\"\n}" } }
        },
        {
          "name": "Import Members",
          "request": { "method": "POST", "url": "{{base_url}}/members/import.php",
            "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
              "raw": "{\n  \"gym_id\": \"{{gym_id}}\",\n  \"members\": [\n    {\"name\": \"Member A\", \"phone\": \"9999999991\"},\n    {\"name\": \"Member B\", \"phone\": \"9999999992\"}\n  ]\n}" } }
        }
      ]
    },
    {
      "name": "Batches",
      "item": [
        { "name": "List Batches", "request": { "method": "GET", "url": { "raw": "{{base_url}}/batches/list.php?gym_id={{gym_id}}",
          "host": ["{{base_url}}"], "path": ["batches", "list.php"], "query": [{ "key": "gym_id", "value": "{{gym_id}}" }] } } },
        { "name": "Create Batch", "request": { "method": "POST", "url": "{{base_url}}/batches/create.php",
          "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
            "raw": "{\n  \"gym_id\": \"{{gym_id}}\",\n  \"batch_name\": \"Morning Batch\",\n  \"start_time\": \"06:00\",\n  \"end_time\": \"08:00\"\n}" } } },
        { "name": "Update Batch", "request": { "method": "POST", "url": "{{base_url}}/batches/update.php",
          "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
            "raw": "{\n  \"gym_id\": \"{{gym_id}}\",\n  \"batch_id\": \"{{batch_id}}\",\n  \"batch_name\": \"Morning Batch\",\n  \"start_time\": \"06:00\",\n  \"end_time\": \"08:00\"\n}" } } },
        { "name": "Delete Batch", "request": { "method": "POST", "url": "{{base_url}}/batches/delete.php",
          "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
            "raw": "{\n  \"gym_id\": \"{{gym_id}}\",\n  \"batch_id\": \"{{batch_id}}\"\n}" } } }
      ]
    },
    {
      "name": "Gym Plans",
      "item": [
        { "name": "List Plans", "request": { "method": "GET", "url": { "raw": "{{base_url}}/gym-plans/list.php?gym_id={{gym_id}}",
          "host": ["{{base_url}}"], "path": ["gym-plans", "list.php"], "query": [{ "key": "gym_id", "value": "{{gym_id}}" }] } } },
        { "name": "Create Plan", "request": { "method": "POST", "url": "{{base_url}}/gym-plans/create.php",
          "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
            "raw": "{\n  \"gym_id\": \"{{gym_id}}\",\n  \"plan_name\": \"Monthly\",\n  \"duration_months\": 1,\n  \"price\": 1000,\n  \"description\": \"\"\n}" } } },
        { "name": "Update Plan", "request": { "method": "POST", "url": "{{base_url}}/gym-plans/update.php",
          "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
            "raw": "{\n  \"gym_id\": \"{{gym_id}}\",\n  \"plan_id\": \"{{plan_id}}\",\n  \"plan_name\": \"Monthly\",\n  \"duration_months\": 1,\n  \"price\": 1000,\n  \"description\": \"\"\n}" } } },
        { "name": "Delete Plan", "request": { "method": "POST", "url": "{{base_url}}/gym-plans/delete.php",
          "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
            "raw": "{\n  \"gym_id\": \"{{gym_id}}\",\n  \"plan_id\": \"{{plan_id}}\"\n}" } } }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        { "name": "Check In", "request": { "method": "POST", "url": "{{base_url}}/attendance/check-in.php",
          "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
            "raw": "{\n  \"gym_id\": \"{{gym_id}}\",\n  \"member_id\": \"{{member_id}}\",\n  \"date\": \"2026-09-27\"\n}" } } },
        { "name": "Daily Attendance", "request": { "method": "GET", "url": { "raw": "{{base_url}}/attendance/daily.php?gym_id={{gym_id}}&date=2026-09-27&filter=&search=",
          "host": ["{{base_url}}"], "path": ["attendance", "daily.php"],
          "query": [{ "key": "gym_id", "value": "{{gym_id}}" }, { "key": "date", "value": "2026-09-27" }, { "key": "filter", "value": "" }, { "key": "search", "value": "" }] } } },
        { "name": "Attendance History", "request": { "method": "GET", "url": { "raw": "{{base_url}}/attendance/history.php?gym_id={{gym_id}}&member_id={{member_id}}",
          "host": ["{{base_url}}"], "path": ["attendance", "history.php"],
          "query": [{ "key": "gym_id", "value": "{{gym_id}}" }, { "key": "member_id", "value": "{{member_id}}" }] } } }
      ]
    },
    {
      "name": "Payments",
      "item": [
        { "name": "List Payments", "request": { "method": "GET", "url": { "raw": "{{base_url}}/payments/list.php?gym_id={{gym_id}}&member_id={{member_id}}",
          "host": ["{{base_url}}"], "path": ["payments", "list.php"],
          "query": [{ "key": "gym_id", "value": "{{gym_id}}" }, { "key": "member_id", "value": "{{member_id}}" }] } } },
        { "name": "Create Payment (manual)", "request": { "method": "POST", "url": "{{base_url}}/payments/create.php",
          "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
            "raw": "{\n  \"gym_id\": \"{{gym_id}}\",\n  \"member_id\": \"{{member_id}}\",\n  \"amount\": 1000,\n  \"payment_method\": \"cash\",\n  \"transaction_id\": \"\"\n}" } } },
        { "name": "Online Payment - Create Order", "request": { "method": "POST", "url": "{{base_url}}/payments/online-order.php",
          "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
            "raw": "{\n  \"gym_id\": \"{{gym_id}}\",\n  \"member_id\": \"{{member_id}}\",\n  \"plan_id\": \"{{plan_id}}\"\n}" } } },
        { "name": "Online Payment - Verify", "request": { "method": "POST", "url": "{{base_url}}/payments/online-verify.php",
          "body": { "mode": "raw", "options": {"raw": {"language": "json"}},
            "raw": "{\n  \"razorpay_order_id\": \"\",\n  \"razorpay_payment_id\": \"\",\n  \"razorpay_signature\": \"\"\n}" } } }
      ]
    },
    {
      "name": "Expenses",
